# Application environment: development | test | production
APP_ENV=development

# PostgreSQL connection string
# Example: postgresql+psycopg://user:password@localhost:5432/naruto_mythos
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/naruto_mythos

# Comma-separated list of allowed CORS origins for browser-based consumers.
# Example: http://localhost:3000,https://example.com
CORS_ORIGINS=http://localhost:3000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Documentation exposure; debug responses are always disabled.
DOCS_ENABLED=true

# Optional origin-protection secret used by RapidAPI before it forwards
# requests to the Railway origin. Leave unset unless the live RapidAPI
# provider configuration is active.
RAPIDAPI_PROXY_SECRET=

# Port suggestion; pass explicitly to Uvicorn with --port.
PORT=8000
